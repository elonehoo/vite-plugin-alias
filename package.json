{
  "name": "vite-plugin-alias",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.34.7",
  "author": "Elone Hoo <huchengyea@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/elonehoo/vite-plugin-alias#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elonehoo/vite-plugin-alias"
  },
  "bugs": "https://github.com/elonehoo/vite-plugin-alias/issues",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "*.d.ts",
    "dist",
    "index.d.cts"
  ],
  "scripts": {
    "play:module": "pnpm -C playground/module run dev",
    "play:common": "pnpm -C playground/common run dev",
    "build": "rimraf dist && unbuild",
    "prepublishOnly": "npm run build",
    "release": "bumpp package.json --commit --push --tag && pnpm -r publish --access public",
    "test": "vitest",
    "test:package": "node scripts/check-package.mjs",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "comment-json": "^4.6.2",
    "consola": "^3.4.2",
    "fast-glob": "^3.3.3",
    "unbuild": "^3.6.1",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@elonehoo/rimraf": "^0.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "12.3.0",
    "c8": "^12.0.0",
    "eslint": "9.39.5",
    "local-pkg": "^1.2.1",
    "pnpm": "10.34.7",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
